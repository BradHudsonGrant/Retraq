<?xml version="1.0" encoding="UTF-8"?>
<!--
  Retraq iOS PrivacyInfo manifest.

  Required by Apple since May 2024 for apps / SDKs that use any of the
  "Required Reason" API categories. Completeness here is checked by
  App Store review automation — missing reasons fail Apple review.

  Declarations:
  - NSPrivacyTracking=false, NSPrivacyTrackingDomains=[] — Retraq does
    not track users across apps or websites.
  - NSPrivacyCollectedDataTypes=[] — Retraq does not collect any user
    data. All journal data is stored locally on the device; no
    network calls (enforced by Task 12.1 CI test).

  Required-reason API categories Retraq touches through its deps:
  - UserDefaults (C56D.1 app functionality) — flutter_secure_storage,
    shared_preferences (if transitively pulled).
  - FileTimestamp (35F9.1 inside app container) — path_provider +
    drift/sqlite3 reading the .sqlite file mtime.
  - SystemBootTime (3D2.1 app functionality) — sqlite3 may query the
    system clock for transactions / timers.
  - DiskSpace (E174.1 app functionality) — sqlite3 checks available
    space during migration and large writes; path_provider may as well.

  If a future dependency adds other required-reason categories (e.g.
  ActiveKeyboards 54BD.1), add them here as part of the same commit
  that introduces the dependency.

  Task 9.5 — completeness audit for App Store submission.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C56D.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>3D2.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
